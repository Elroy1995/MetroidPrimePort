<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Windows: make UTF-8 the process's ANSI code page (Windows 10 1903 and later).
     SDL hands paths over as UTF-8, and the port passes them to narrow APIs
     (std::filesystem::path from char, std::ifstream, fopen). Without this they
     are read in the legacy code page, so a disc or user folder with non-ASCII
     characters in its path is not found, or a conversion throws. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
